{
  "app": {
    "name": "SClass",
    "description": "Your classroom scheduling workspace.",
    "environment": "development"
  },
  "server": {
    "cors_origins": ["http://localhost:5173", "http://127.0.0.1:5173"]
  },
  "supabase": {
    "url_env": "SUPABASE_URL",
    "key_env": "SUPABASE_KEY",
    "healthcheck_table": "rooms",
    "timeout_seconds": 8
  },
  "scheduling": {
    "timezone": "Asia/Kuala_Lumpur",
    "opening_hours": {
      "monday": {"opens_at": "08:30", "closes_at": "18:00"},
      "tuesday": {"opens_at": "08:30", "closes_at": "18:00"},
      "wednesday": {"opens_at": "08:30", "closes_at": "18:00"},
      "thursday": {"opens_at": "08:30", "closes_at": "18:00"},
      "friday": {"opens_at": "08:30", "closes_at": "18:00"}
    },
    "closed_dates": [],
    "room_compatibility": {
      "lecture": ["classroom", "auditorium"],
      "tutorial": ["classroom", "lab"],
      "lab": ["classroom", "lab"],
      "others": []
    },
    "min_gap_minutes": 15,
    "reserved_room_types": ["auditorium"],
    "solver": {
      "max_time_seconds": 280,
      "num_search_workers": 1,
      "random_seed": 0
    },
    "quality": {
      "enabled": true,
      "objectives": [
        {"name": "student_idle", "weight": 100},
        {"name": "lecturer_idle", "weight": 10},
        {"name": "room_fit", "weight": 1}
      ]
    }
  }
}
