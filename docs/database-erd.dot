digraph ERD {
graph [rankdir=LR,bgcolor="#F8FAFC",pad=0.5,nodesep=0.6,ranksep=1.1,splines=polyline,outputorder=edgesfirst,fontname="Arial",fontsize=23,labelloc=t,label="SMART CAMPUS | Full Database ERD\nMultiple intake memberships | Course durations | Start-only class sessions\n \nPK = primary key   FK = foreign key   UK = unique   UK* = combined course code + type"];
node [shape=plain,fontname="Arial"];
edge [fontname="Arial",fontsize=10,color="#64748B",fontcolor="#475569",penwidth=1.3,arrowsize=0.75,dir=both,labeldistance=1.8];
