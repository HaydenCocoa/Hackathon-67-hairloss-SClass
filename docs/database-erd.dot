SCHEDULE_CHANGES [label=<<TABLE BORDER="1" COLOR="#CBD5E1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD COLSPAN="3" CELLPADDING="13" BGCOLOR="#7C3AED"><FONT COLOR="white" POINT-SIZE="16"><B>SCHEDULE_CHANGES</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="7" BGCOLOR="#F1F5F9"><B>FIELD</B></TD><TD ALIGN="LEFT" CELLPADDING="7" BGCOLOR="#F1F5F9"><B>TYPE</B></TD><TD ALIGN="LEFT" CELLPADDING="7" BGCOLOR="#F1F5F9"><B>KEY</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id" CELLPADDING="7"><FONT COLOR="#0F172A">id</FONT></TD><TD ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#64748B">uuid</FONT></TD><TD ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#7C3AED"><B>PK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="class_session_id" CELLPADDING="7"><FONT COLOR="#0F172A">class_session_id</FONT></TD><TD ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#64748B">uuid</FONT></TD><TD ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#7C3AED"><B>FK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="meeting_session_id" CELLPADDING="7"><FONT COLOR="#0F172A">meeting_session_id</FONT></TD><TD ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#64748B">uuid</FONT></TD><TD ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#7C3AED"><B>FK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="changed_by" CELLPADDING="7"><FONT COLOR="#0F172A">changed_by</FONT></TD><TD ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#64748B">uuid</FONT></TD><TD ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#7C3AED"><B>FK</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="action" CELLPADDING="7"><FONT COLOR="#0F172A">action</FONT></TD><TD ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#64748B">text</FONT></TD><TD ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#7C3AED"><B> </B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="reason" CELLPADDING="7"><FONT COLOR="#0F172A">reason</FONT></TD><TD ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#64748B">text</FONT></TD><TD ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#7C3AED"><B> </B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="old_values" CELLPADDING="7"><FONT COLOR="#0F172A">old_values</FONT></TD><TD ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#64748B">jsonb</FONT></TD><TD ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#7C3AED"><B> </B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="new_values" CELLPADDING="7"><FONT COLOR="#0F172A">new_values</FONT></TD><TD ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#64748B">jsonb</FONT></TD><TD ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#7C3AED"><B> </B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at" CELLPADDING="7"><FONT COLOR="#0F172A">created_at</FONT></TD><TD ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#64748B">timestamptz</FONT></TD><TD ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#7C3AED"><B> </B></FONT></TD></TR></TABLE>>];
AUTH_USERS -> STUDENTS:auth_user_id [arrowtail="teeodot",arrowhead="teeodot",taillabel="0..1",headlabel="0..1",style=dashed,color="#93A8CD",constraint=false];
AUTH_USERS -> LECTURERS:auth_user_id [arrowtail="teeodot",arrowhead="teeodot",taillabel="0..1",headlabel="0..1",style=dashed,color="#93A8CD",constraint=false];
