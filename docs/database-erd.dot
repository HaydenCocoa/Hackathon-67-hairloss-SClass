ROOMS -> CLASS_SESSIONS:room_id [arrowtail="teeodot",arrowhead="crowodot",taillabel="0..1",headlabel="0..*"];
LECTURERS -> MEETING_SESSIONS:lecturer_id [arrowtail="teetee",arrowhead="crowodot",taillabel="1",headlabel="0..*"];
