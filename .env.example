# Copy to .env in the project root. FastAPI loads this file at startup.
SUPABASE_URL=https://your-project.supabase.co
# Use a server-only secret key (sb_secret_...) or legacy service_role key.
# The existing schema does not grant anonymous users access to rooms.
# Never put this key in Config/config.json or a VITE_* variable.
SUPABASE_KEY=

# LOCAL DEV ONLY: lets you open /#/admin without the shared login (localhost requests only,
# and only when Config/config.json environment is "development"). Remove or set to 0 once
# the real login flow exists. Never enable on a deployed server.
ADMIN_DEV_BYPASS=1
